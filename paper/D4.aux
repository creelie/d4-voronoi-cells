\@writefile{lof}{\contentsline {figure}{\numberline {46}{\ignorespaces Richardson-extrapolated minimum eigenvalue of the joint Hessian $H_A$ for chains of length $m=3,\dots  ,8$ (\cref  {lem:chains-new}; full values in \cref  {app:numerical-tables}). The value falls from $m=3$ to $m=5$ and then levels off near $0.1676$. It stays away from zero up to $m=8$, the longest induced path in the contact graph of $\mathsf  {R}$, so numerically the second-order method gives positivity for every chain.}}{155}{figure.46}\protected@file@percent }
\newlabel{fig:chain-plateau}{{46}{155}{Richardson-extrapolated minimum eigenvalue of the joint Hessian $H_A$ for chains of length $m=3,\dots ,8$ (\cref {lem:chains-new}; full values in \cref {app:numerical-tables}). The value falls from $m=3$ to $m=5$ and then levels off near $0.1676$. It stays away from zero up to $m=8$, the longest induced path in the contact graph of $\Rt $, so numerically the second-order method gives positivity for every chain}{figure.46}{}}
